{
  "name": "react-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run dev:server\"",
    "dev:server": "tsx watch server/index.ts",
    "developer:index": "node --import tsx server/developer-cli.ts --index",
    "developer:cli": "node --import tsx server/developer-cli.ts",
    "developer:check": "node --import tsx server/developer-check.ts",
    "test:developer": "node --import tsx --test server/developer-assistant.test.ts",
    "review:pr": "node --import tsx server/code-review-cli.ts",
    "review:demo": "node --import tsx server/code-review-demo.ts",
    "test:review": "node --import tsx --test server/code-review.test.ts",
    "start": "npm run build && npm run start:server",
    "start:server": "NODE_ENV=production tsx server/index.ts",
    "agents:cli": "tsx server/agent-cli.ts",
    "mcp:demo": "tsx server/mcp-client.ts",
    "test:mcp:e2e": "tsx server/calendar-mcp-e2e.ts",
    "test:mcp:pipeline:e2e": "tsx server/calendar-pipeline-e2e.ts",
    "test:calendar:slots": "tsx --test server/calendar-slots.test.ts server/calendar-pipeline-mcp.test.ts",
    "test:telegram:mcp": "tsx --test server/telegram-mcp.test.ts",
    "test:mcp:orchestration": "tsx --test server/mcp-orchestration.test.ts server/telegram-mcp.test.ts",
    "test:scheduler:smoke": "tsx server/scheduler-smoke.ts",
    "test:scheduler:local": "tsx --test --test-concurrency=1 server/scheduler-local.test.ts",
    "rag:index": "tsx server/rag-cli.ts index",
    "rag:stats": "tsx server/rag-cli.ts stats",
    "rag:search": "tsx server/rag-cli.ts search",
    "rag:demo": "tsx server/rag-cli.ts demo",
    "test:rag": "tsx --test server/rag-indexer.test.ts",
    "test:rag:agent": "tsx --test server/rag-agent.test.ts",
    "test:rag:retrieval": "tsx --test server/rag-retrieval.test.ts server/rag-report.test.ts",
    "test:rag:grounding": "tsx --test server/rag-grounding.test.ts",
    "test:rag:chat": "tsx --test server/rag-chat.test.ts server/response-preferences.test.ts",
    "rag:check-chat": "tsx server/rag-chat-evaluate.ts",
    "rag:check-grounding": "tsx server/rag-grounding-evaluate.ts",
    "rag:evaluate": "tsx server/rag-evaluate.ts",
    "rag:check-questions": "tsx server/rag-check-questions.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "llm:local:demo": "tsx server/local-llm-demo.ts --auto",
    "llm:local:chat": "tsx server/local-llm-demo.ts",
    "rag:local:evaluate": "tsx server/local-rag-evaluate.ts",
    "llm:optimize:evaluate": "node --import tsx server/llm-optimization-evaluate.ts",
    "llm:optimize:tune": "node --import tsx server/llm-optimization-tune.ts",
    "llm:optimize:review": "node --import tsx server/llm-optimization-review.ts",
    "test:llm:optimization": "node --import tsx --test server/llm-optimization.test.ts server/llm-optimization-judge.test.ts server/llm-optimization-runner.test.ts",
    "llm:service:init": "tsx server/private-llm-init.ts",
    "llm:service:build": "vite build --config vite.private-llm.config.ts",
    "llm:service": "npm run llm:service:build && npm run llm:service:start",
    "llm:service:start": "tsx server/private-llm-server.ts",
    "llm:service:check": "tsx server/private-llm-check.ts",
    "llm:service:queue-demo": "tsx server/private-llm-queue-demo.ts",
    "test:llm:service": "node --import tsx --test server/private-llm.test.ts server/local-llm-context.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "katex": "^0.18.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
