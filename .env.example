DEEPSEEK_API_KEY=your_deepseek_api_key_here
YANDEX_CALDAV_EMAIL=
# Укажите только один вариант авторизации. Не коммитьте настоящий секрет.
YANDEX_CALDAV_APP_PASSWORD=
YANDEX_CALDAV_OAUTH_TOKEN=
# Telegram MCP: создайте бота через @BotFather, напишите ему /start и укажите
# chat id из ответа getUpdates. Не коммитьте настоящий токен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEEPSEEK_MODEL=deepseek-v4-flash
HUGGINGFACE_API_KEY=your_huggingface_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PORT=8787
AGENT_TIME_ZONE=Asia/Omsk
# Планировщик запускается вместе с API. Данные сохраняются локально в data/.
# Необязательный путь к SQLite (по умолчанию data/scheduler.sqlite):
# SCHEDULER_DB_PATH=./data/scheduler.sqlite

# Локальные embedding-модель и индекс для задания Day 21 (RAG).
# Перед первой индексацией установите Ollama и выполните: ollama pull nomic-embed-text-v2-moe
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
# RAG_INDEX_PATH=data/rag-index.sqlite

# Генеративная локальная модель Day 26.
OLLAMA_CHAT_MODEL=qwen3.5:4b

# Контекст и максимальная длина ответа (независимые параметры).
OLLAMA_CHAT_CONTEXT=32768
OLLAMA_CHAT_MAX_TOKENS=4096

# Необязательная модель для сравнения квантования Day 29.
OLLAMA_OPTIMIZATION_Q8_MODEL=qwen3.5:4b-q8_0

# Независимый агент оценки ответов Day 29 (использует DEEPSEEK_API_KEY).
DEEPSEEK_JUDGE_MODEL=deepseek-v4-pro
DEEPSEEK_JUDGE_CONCURRENCY=3

# День 30: npm run llm:service создаёт отдельный data/private-llm.env с ключом.
# Ollama остаётся на 127.0.0.1:11434, в домашнюю сеть выходит только сервис.
# Настройки приватного сервиса (редактировать в data/private-llm.env):
# PRIVATE_LLM_HOST=0.0.0.0
# PRIVATE_LLM_PORT=8788
# PRIVATE_LLM_CONTEXT=8192
# PRIVATE_LLM_MAX_TOKENS=1024
# PRIVATE_LLM_RATE_LIMIT=12
# PRIVATE_LLM_TIMEOUT_MS=120000
# PRIVATE_LLM_QUEUE_SIZE=3
# PRIVATE_LLM_QUEUE_TIMEOUT_MS=60000
# PRIVATE_LLM_LOG_PROMPTS=1
