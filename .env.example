DEEPSEEK_API_KEY=your_deepseek_api_key_here
YANDEX_CALDAV_EMAIL=
# Укажите только один вариант авторизации. Не коммитьте настоящий секрет.
YANDEX_CALDAV_APP_PASSWORD=
YANDEX_CALDAV_OAUTH_TOKEN=
DEEPSEEK_MODEL=deepseek-v4-flash
HUGGINGFACE_API_KEY=your_huggingface_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PORT=8787
AGENT_TIME_ZONE=Asia/Omsk
# Планировщик запускается вместе с API. Данные сохраняются локально в data/.
# Необязательный путь к SQLite (по умолчанию data/scheduler.sqlite):
# SCHEDULER_DB_PATH=./data/scheduler.sqlite
