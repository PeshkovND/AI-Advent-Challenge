DEEPSEEK_API_KEY=your_deepseek_api_key_here
YANDEX_CALDAV_EMAIL=
# Укажите только один вариант авторизации. Не коммитьте настоящий секрет.
YANDEX_CALDAV_APP_PASSWORD=
YANDEX_CALDAV_OAUTH_TOKEN=
# Telegram MCP: создайте бота через @BotFather, напишите ему /start и укажите
# chat id из ответа getUpdates. Не коммитьте настоящий токен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEEPSEEK_MODEL=deepseek-v4-flash
HUGGINGFACE_API_KEY=your_huggingface_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PORT=8787
AGENT_TIME_ZONE=Asia/Omsk
# Планировщик запускается вместе с API. Данные сохраняются локально в data/.
# Необязательный путь к SQLite (по умолчанию data/scheduler.sqlite):
# SCHEDULER_DB_PATH=./data/scheduler.sqlite

# Локальные embedding-модель и индекс для задания Day 21 (RAG).
# Перед первой индексацией установите Ollama и выполните: ollama pull nomic-embed-text-v2-moe
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
# RAG_INDEX_PATH=data/rag-index.sqlite
